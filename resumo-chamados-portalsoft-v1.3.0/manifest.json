{
  "manifest_version": 3,
  "name": "Resumo Técnico de Chamados - Portalsoft",
  "version": "1.4.2",
  "description": "Expande o histórico do chamado e copia um prompt técnico textual.",
  "permissions": [
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://ticket.portalsoft.com.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ticket.portalsoft.com.br/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
